{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-world-route.vercel.app/data/platform/traveller-rule-schema.json",
  "title": "ONE WORLD ROUTE Traveller-specific Rule",
  "type": "object",
  "required": ["id", "domain", "destination", "applicability", "outcome", "validity", "evidence", "reviewStatus"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "domain": {"enum": ["entry", "visa", "transit", "health", "insurance", "driving", "transport", "payment", "connectivity", "accessibility", "customs", "safety", "other"]},
    "destination": {
      "type": "object",
      "properties": {
        "countryCodes": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{2}$"}},
        "placeIds": {"type": "array", "items": {"type": "string"}}
      }
    },
    "applicability": {
      "type": "object",
      "properties": {
        "passportCountries": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{2}$"}},
        "excludedPassportCountries": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{2}$"}},
        "residenceCountries": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{2}$"}},
        "minAge": {"type": ["integer", "null"], "minimum": 0},
        "maxAge": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "outcome": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["allowed", "required", "conditional", "restricted", "not-applicable", "unknown"]},
        "message": {"type": ["object", "string"]},
        "action": {"type": ["object", "string", "null"]}
      }
    },
    "validity": {
      "type": "object",
      "properties": {
        "validFrom": {"type": ["string", "null"], "format": "date"},
        "validUntil": {"type": ["string", "null"], "format": "date"}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "title", "checkedAt"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "title": {"type": "string"},
          "issuer": {"type": ["string", "null"]},
          "issuerType": {"enum": ["government", "official-operator", "international-organization", "primary-source", "secondary-source"]},
          "checkedAt": {"type": "string", "format": "date"}
        }
      }
    },
    "reviewStatus": {"enum": ["verified", "needs-review", "expired", "draft"]}
  },
  "description": "Rules are matched against explicit Traveller Context. Never infer passport citizenship or residence from language, IP address, currency, route origin or prior behaviour."
}

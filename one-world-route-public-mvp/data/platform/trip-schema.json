{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-world-route.vercel.app/data/platform/trip-schema.json",
  "title": "ONE WORLD ROUTE Trip",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "kind",
    "places",
    "stops",
    "segments"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kind": {
      "enum": [
        "world",
        "round-trip",
        "road-trip",
        "rail",
        "cruise",
        "island-hopping",
        "city-break",
        "expedition",
        "custom"
      ]
    },
    "places": {
      "type": "array"
    },
    "stops": {
      "type": "array"
    },
    "segments": {
      "type": "array"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "issuer",
          "issuerType",
          "url",
          "checkedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "issuerType": {
            "enum": [
              "government",
              "official-operator",
              "international-organization",
              "primary-source",
              "secondary-source"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "checkedAt": {
            "type": "string",
            "format": "date"
          },
          "validFrom": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "validUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "entryGuidance": {
      "type": [
        "object",
        "null"
      ]
    },
    "cruise": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "nights": {
          "type": "integer",
          "minimum": 0
        },
        "seaDays": {
          "type": "integer",
          "minimum": 0
        },
        "embarkationStopId": {
          "type": [
            "string",
            "null"
          ]
        },
        "disembarkationStopId": {
          "type": [
            "string",
            "null"
          ]
        },
        "operator": {
          "type": [
            "string",
            "null"
          ]
        },
        "vessel": {
          "type": [
            "string",
            "null"
          ]
        },
        "sailingDate": {
          "type": [
            "string",
            "null"
          ]
        },
        "bookingState": {
          "enum": [
            "illustrative-template",
            "planning",
            "selected",
            "booked"
          ]
        },
        "requiresSailingSelection": {
          "type": "boolean"
        }
      }
    },
    "roadTrip": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "vehicleContextRequired": {
          "type": "boolean"
        },
        "rentalCrossBorderApprovalRequired": {
          "enum": [
            "operator-dependent",
            true,
            false
          ]
        },
        "vehicleOwnershipModes": {
          "type": "array",
          "items": {
            "enum": [
              "private",
              "rental",
              "camper",
              "motorcycle",
              "other"
            ]
          }
        },
        "rule": {
          "type": "string"
        }
      }
    }
  },
  "x-oneWorldRoute": {
    "model": "place -> visit(stop) -> segment",
    "transportModes": [
      "walk",
      "bicycle",
      "road",
      "car",
      "motorcycle",
      "bus",
      "coach",
      "rail",
      "metro",
      "tram",
      "ground-transfer",
      "rideshare",
      "taxi",
      "ferry",
      "cruise",
      "flight",
      "helicopter",
      "rail+ground",
      "multimodal",
      "other"
    ],
    "notes": "Cruises use the same segment model. Each port call is a stop; sea legs use mode cruise, may carry onboardNights/service metadata, and can revisit the same place through distinct stop IDs.",
    "evidence": {
      "rule": "Verified route facts must point to sourceIds that resolve in the trip source registry. Schedule-dependent facts remain current-check-required.",
      "durationBases": [
        "operator-published",
        "operator-published-fastest",
        "published-coach-stage-only",
        "partial-published",
        "connection-time-required",
        "connection-time-excluded",
        "live-timetable-required"
      ],
      "costBases": [
        "published-fare",
        "published-from",
        "published-stage-floor",
        "known-stage-floor"
      ]
    },
    "cruise": {
      "stopCallKinds": [
        "embarkation",
        "port-call",
        "disembarkation",
        "overnight-port-call"
      ],
      "segmentFields": [
        "onboardNights",
        "seaDayNumbers",
        "operator",
        "vessel",
        "serviceStatus"
      ],
      "borderTransitions": [
        "domestic",
        "schengen-internal",
        "schengen-exit",
        "schengen-entry",
        "international"
      ],
      "rule": "Sea days belong to cruise segments, not fictional geographic places. Port calls are visit/stop records. Repeated home ports use distinct stop IDs linked to one place."
    },
    "discovery": {
      "regions": "array of normalized filter slugs",
      "themes": "array of normalized filter slugs",
      "modes": "array of normalized mode slugs",
      "durationBand": "7-14 | 15-30 | 31-89 | 90-plus",
      "rule": "Discovery metadata is catalog metadata; trip detail remains authoritative."
    },
    "roadTrip": {
      "vehicleContextFields": [
        "type",
        "registrationCountry",
        "fuelType",
        "euroClass",
        "rentalCrossBorderApproved"
      ],
      "rule": "Tolls, low-emission zones, rental permissions and urban access must not be resolved without the relevant vehicle and traveller context."
    },
    "discoveryFit": {
      "pace": [
        "relaxed",
        "balanced",
        "active"
      ],
      "seasons": [
        "spring",
        "summer",
        "autumn",
        "winter",
        "multi-season"
      ],
      "party": [
        "solo",
        "couples",
        "friends",
        "families"
      ],
      "startRegion": "normalized region slug",
      "accessibility": [
        "standard-check",
        "operator-dependent",
        "vehicle-dependent",
        "complex-planning"
      ],
      "rule": "Route Fit is transparent editorial discovery metadata. It filters routes; it must not be presented as a safety, medical, legal or accessibility guarantee."
    }
  }
}

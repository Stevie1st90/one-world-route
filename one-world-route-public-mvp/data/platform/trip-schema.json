{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-world-route.vercel.app/data/platform/trip-schema.json",
  "title": "ONE WORLD ROUTE Trip",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "kind",
    "places",
    "stops",
    "segments"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Open normalized trip-kind slug. New trip kinds must not require renderer changes."
    },
    "places": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "extensions": {
            "$ref": "#/$defs/extensions"
          },
          "experienceRef": {
            "type": "string",
            "pattern": "^[A-Z]{2}:[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Reference to reusable evergreen place-experience content. Shared across trips; operational facts do not belong here."
          }
        },
        "additionalProperties": true
      }
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "extensions": {
            "$ref": "#/$defs/extensions"
          }
        },
        "additionalProperties": true
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "extensions": {
            "$ref": "#/$defs/extensions"
          }
        },
        "additionalProperties": true
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "issuer",
          "issuerType",
          "url",
          "checkedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "issuerType": {
            "enum": [
              "government",
              "official-operator",
              "international-organization",
              "primary-source",
              "secondary-source"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "checkedAt": {
            "type": "string",
            "format": "date"
          },
          "validFrom": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "validUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "entryGuidance": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "personalizationRequired",
        "destinationCountry",
        "tripPurpose",
        "officialResolverSourceId",
        "message"
      ],
      "properties": {
        "personalizationRequired": {
          "const": true
        },
        "destinationCountry": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "tripPurpose": {
          "type": "string",
          "minLength": 1
        },
        "stayDays": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "officialResolverSourceId": {
          "type": "string",
          "minLength": 1
        },
        "supportingSourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "message": {
          "type": [
            "object",
            "string"
          ]
        }
      }
    },
    "cruise": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "nights": {
          "type": "integer",
          "minimum": 0
        },
        "seaDays": {
          "type": "integer",
          "minimum": 0
        },
        "embarkationStopId": {
          "type": [
            "string",
            "null"
          ]
        },
        "disembarkationStopId": {
          "type": [
            "string",
            "null"
          ]
        },
        "operator": {
          "type": [
            "string",
            "null"
          ]
        },
        "vessel": {
          "type": [
            "string",
            "null"
          ]
        },
        "sailingDate": {
          "type": [
            "string",
            "null"
          ]
        },
        "bookingState": {
          "enum": [
            "illustrative-template",
            "planning",
            "selected",
            "booked"
          ]
        },
        "requiresSailingSelection": {
          "type": "boolean"
        }
      }
    },
    "roadTrip": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "vehicleContextRequired": {
          "type": "boolean"
        },
        "rentalCrossBorderApprovalRequired": {
          "enum": [
            "operator-dependent",
            true,
            false
          ]
        },
        "vehicleOwnershipModes": {
          "type": "array",
          "items": {
            "enum": [
              "private",
              "rental",
              "camper",
              "motorcycle",
              "other"
            ]
          }
        },
        "rule": {
          "type": "string"
        }
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    },
    "media": {
      "type": [
        "object",
        "null"
      ],
      "description": "Presentation media. Art-directed themes are license-free UI art; external or local photo assets must carry attribution/license metadata.",
      "properties": {
        "hero": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "type": {
              "enum": [
                "art-directed",
                "image"
              ]
            },
            "theme": {
              "type": [
                "string",
                "null"
              ]
            },
            "asset": {
              "type": [
                "string",
                "null"
              ]
            },
            "attribution": {
              "type": [
                "string",
                "null"
              ]
            },
            "license": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        "gallery": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "routePolicy": {
      "type": [
        "object",
        "null"
      ],
      "description": "Controls safe runtime personalization without trip-specific renderer code.",
      "properties": {
        "startMode": {
          "enum": [
            "fixed",
            "endpoints",
            "any-stop"
          ]
        },
        "reversible": {
          "type": "boolean"
        },
        "reverseEvidenceReusable": {
          "type": "boolean"
        },
        "reversePlanningReusable": {
          "type": "boolean"
        },
        "originMode": {
          "enum": [
            "traveller-context",
            "fixed"
          ]
        },
        "originAccess": {
          "enum": [
            "none",
            "dynamic"
          ]
        },
        "returnMode": {
          "enum": [
            "none",
            "to-origin"
          ]
        },
        "preserveCoreRoute": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "maintenance": {
      "type": [
        "object",
        "null"
      ],
      "description": "Content maintenance metadata. Stable editorial structure stays separate from volatile travel facts.",
      "properties": {
        "tier": {
          "enum": [
            "evergreen",
            "seasonal",
            "live-dependent"
          ]
        },
        "sourceReviewDays": {
          "type": "integer",
          "minimum": 1
        },
        "sharedKnowledge": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "x-oneWorldRoute": {
    "model": "place -> visit(stop) -> segment",
    "transportModes": [
      "walk",
      "bicycle",
      "road",
      "car",
      "motorcycle",
      "bus",
      "coach",
      "rail",
      "metro",
      "tram",
      "ground-transfer",
      "rideshare",
      "taxi",
      "ferry",
      "cruise",
      "flight",
      "helicopter",
      "rail+ground",
      "multimodal",
      "other"
    ],
    "notes": "Cruises use the same segment model. Each port call is a stop; sea legs use mode cruise, may carry onboardNights/service metadata, and can revisit the same place through distinct stop IDs.",
    "evidence": {
      "rule": "Verified route facts must point to sourceIds that resolve in the trip source registry. Schedule-dependent facts remain current-check-required.",
      "durationBases": [
        "operator-published",
        "operator-published-fastest",
        "published-coach-stage-only",
        "partial-published",
        "connection-time-required",
        "connection-time-excluded",
        "live-timetable-required"
      ],
      "costBases": [
        "published-fare",
        "published-from",
        "published-stage-floor",
        "known-stage-floor"
      ]
    },
    "cruise": {
      "stopCallKinds": [
        "embarkation",
        "port-call",
        "disembarkation",
        "overnight-port-call"
      ],
      "segmentFields": [
        "onboardNights",
        "seaDayNumbers",
        "operator",
        "vessel",
        "serviceStatus"
      ],
      "borderTransitions": [
        "domestic",
        "schengen-internal",
        "schengen-exit",
        "schengen-entry",
        "international"
      ],
      "rule": "Sea days belong to cruise segments, not fictional geographic places. Port calls are visit/stop records. Repeated home ports use distinct stop IDs linked to one place."
    },
    "discovery": {
      "regions": "array of normalized filter slugs",
      "themes": "array of normalized filter slugs",
      "modes": "array of normalized mode slugs",
      "durationBand": "7-14 | 15-30 | 31-89 | 90-plus",
      "rule": "Discovery metadata is catalog metadata; trip detail remains authoritative."
    },
    "roadTrip": {
      "vehicleContextFields": [
        "type",
        "registrationCountry",
        "fuelType",
        "euroClass",
        "rentalCrossBorderApproved"
      ],
      "rule": "Tolls, low-emission zones, rental permissions and urban access must not be resolved without the relevant vehicle and traveller context."
    },
    "discoveryFit": {
      "pace": [
        "relaxed",
        "balanced",
        "active"
      ],
      "seasons": [
        "spring",
        "summer",
        "autumn",
        "winter",
        "multi-season"
      ],
      "party": [
        "solo",
        "couples",
        "friends",
        "families"
      ],
      "startRegion": "normalized region slug",
      "accessibility": [
        "standard-check",
        "operator-dependent",
        "vehicle-dependent",
        "complex-planning"
      ],
      "rule": "Route Fit is transparent editorial discovery metadata. It filters routes; it must not be presented as a safety, medical, legal or accessibility guarantee."
    },
    "knownTripKinds": [
      "world",
      "round-trip",
      "road-trip",
      "rail",
      "cruise",
      "island-hopping",
      "city-break",
      "expedition",
      "custom"
    ],
    "extensionContract": {
      "rule": "Core route rendering depends only on place -> stop -> segment. Specialized behavior belongs in namespaced extensions and registered presenters/validators, never trip-id branches.",
      "compatibility": "Runtime reads node.extensions first and can adapt legacy cruise, roadTrip, call, roadContext and borderContext fields during migration.",
      "examples": [
        "cruise",
        "roadTrip",
        "road",
        "border",
        "cruiseCall"
      ],
      "nodeScopes": [
        "trip",
        "place",
        "stop",
        "segment"
      ],
      "schemaRule": "Every model layer may carry a namespaced extensions object; the core schema remains open to extension namespaces."
    },
    "capabilities": {
      "rule": "Catalog capabilities declare available experiences (for example terrain, story, traveller-context, source-evidence). UI must inspect capabilities/registered extensions rather than hard-code a trip ID.",
      "rendererRule": "All normal curated trips use the generic regional renderer unless a deliberately separate renderer is registered."
    },
    "media": {
      "rule": "Visual discovery is separate from route evidence. Art-directed themes require no third-party media. Any image asset must store source/attribution/license metadata and must never imply route verification.",
      "heroTypes": [
        "art-directed",
        "image"
      ]
    },
    "personalization": {
      "rule": "Traveller origin changes access/return planning and recommendation context. The curated core route changes only when routePolicy explicitly permits endpoint reversal or loop rotation. Directional live facts are never invented.",
      "startModes": [
        "fixed",
        "endpoints",
        "any-stop"
      ],
      "architecture": "user origin -> access layer -> core journey -> return layer",
      "originAccessModes": [
        "none",
        "dynamic"
      ],
      "returnModes": [
        "none",
        "to-origin"
      ]
    },
    "maintenance": {
      "rule": "Keep stable route/editorial content in the trip dataset. Keep volatile transport, access, entry, price and seasonal guidance source-backed and reviewable. Do not duplicate the same volatile claim across many trips when shared knowledge can represent it."
    },
    "journeyGuide": {
      "rule": "Regional Journey Guide content is derived from the canonical trip graph. It summarizes stop timing, transport modes, price coverage, verification state and route-context checks without duplicating volatile facts.",
      "inputs": [
        "stop.dayStart",
        "stop.dayEnd",
        "segment.transport.mode",
        "segment.planning.cost",
        "segment.verification.status",
        "entryGuidance",
        "routePolicy",
        "catalog capabilities"
      ],
      "maintenance": "Improve the canonical route/evidence data; do not hand-copy derived guide facts into separate per-trip prose."
    },
    "placeExperience": {
      "rule": "Stable destination inspiration is reusable place content, separate from route-specific planning and volatile facts.",
      "reference": "place.experienceRef -> data/platform/place-experiences/<country>.json profile id",
      "loading": "Only shards referenced by the active journey are loaded.",
      "content": "Localized evergreen essence plus normalized discovery tags.",
      "maintenance": "Profiles carry reviewedAt and reviewDays. Timetables, fares, entry rules, closures and other volatile claims must remain in sourced planning layers."
    }
  },
  "$defs": {
    "extensions": {
      "type": "object",
      "description": "Namespaced extension payloads. Unknown namespaces are allowed and must be ignored safely by the core runtime.",
      "additionalProperties": true
    }
  }
}
